{
    "assets" : {
        "kind": "static",
        "label": "Assets",
        "icon": "folder",
        "child_filters": {
            "deliverable": {
                "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.asset-1.0.0'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Asset'"
            }
        }
    },
    "shots" : {
        "kind": "static",
        "label": "Shots",
        "icon": "folder",
        "child_filters": {
            "deliverable": {
                "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.shot-1.0.0'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Shot'"
            }
        }
    },
    "sequences" : {
        "kind": "static",
        "label": "Sequences",
        "icon": "folder",
        "child_filters": {
            "deliverable": {
                "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.sequence-1.0.0'"
            }
        }
    },
    "{sg_asset_type}": {
        "kind": "token",
        "label": "{DATA.PROPERTY(name)}",
        "icon": "folder",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.dynamicEnum-1.0.0';components[medm21619349.shared:type.dynamicEnum-1.0.0].propertyScope=='Asset Type'",
            "assets_resolver": "COMPONENT(name=Dynamic Enum).PROPERTY($id:values)",
            "data_resolver": "COMPONENT(name=Dynamic Enum Value)"
        },
        "child_filters": {
            "asset": {
                "search_filter": "components[medm21619349.shared:type.deliverable.asset-1.0.0].assetType=='{DATA.COMPONENT(name=Dynamic Enum Value).PROPERTY(name)}'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Asset'"
            }
        }
    },
    "{sg_asset_type}+No Type": {
        "kind": "static",
        "label": "Assets with no Type",
        "icon": "folder",
        "child_filters": {
            "asset": {
                "search_filter": "components[medm21619349.shared:type.deliverable.asset-1.0.0].assetType=='No Type'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Asset'"
            }
        }
    },
    "{sg_shot_type}": {
        "kind": "token",
        "label": "{DATA.PROPERTY(name)}",
        "icon": "folder",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.dynamicEnum-1.0.0';components[medm21619349.shared:type.dynamicEnum-1.0.0].propertyScope=='Shot Type'",
            "assets_resolver": "COMPONENT(name=Dynamic Enum).PROPERTY($id:values)",
            "data_resolver": "COMPONENT(name=Dynamic Enum Value)"
        },
        "child_filters": {
            "shot": {
                "search_filter": "components[medm21619349.shared:type.deliverable.shot-1.0.0].shotType=='{DATA.COMPONENT(name=Dynamic Enum Value).PROPERTY(name)}'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Shot'"
            }
        }
    },
    "{sg_shot_type}+No Type": {
        "kind": "static",
        "label": "Shots with no Type",
        "icon": "folder",
        "child_filters": {
            "shot": {
                "search_filter": "components[medm21619349.shared:type.deliverable.shot-1.0.0].shotType=='No Type'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Shot'"
            }
        }
    },
    "{Asset}": {
        "kind": "token",
        "label": "{DATA.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.asset-1.0.0'"
        },
        "child_filters": {
            "step": {
                "assets_resolver": "COMPONENT(name=Pipeline Steps).PROPERTY($id:targetStep)"
            }
        }
    },
    "{Step}": {
        "kind": "token",
        "label": "{DATA.PROPERTY(name)}",
        "icon": "color:{DATA.PROPERTY(backgroundColor)}",
        "color": "{DATA.PROPERTY(backgroundColor)}",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.pipelineStep-1.0.3'",
            "data_resolver": "COMPONENT(name=Pipeline Step)"
        }
    },
    "{Episode}": {
        "kind": "token",
        "label": "{DATA.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.episode-1.0.0'"
        },
        "child_filters": {
            "sequence": {
                "search_filter": "components[medm21619349.shared:type.deliverable.sequence-1.0.0].episode.objectId.id=={DATA.ATTRIBUTE(id)}",
                "disable_tokens": [
                    "{Sequence}+No Sequence"
                ]
            }
        }
    },
    "{Episode}+No Episode": {
        "kind": "static",
        "label": "Sequences with no Episode",
        "icon": "asset",
        "child_filters": {
            "sequence": {
                "search_filter": "components[medm21619349.shared:type.deliverable.sequence-1.0.0].episode.objectId.id=notstartswith='urn:medm:'"
            }
        }
    },
    "{Sequence}": {
        "kind": "token",
        "label": "{DATA.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.sequence-1.0.0'"
        },
        "child_filters": {
            "shot": {
                "search_filter": "components[medm21619349.shared:type.deliverable.shot-1.0.0].sequence.objectId.id=={DATA.ATTRIBUTE(id)}"
            }
        }
    },
    "{Sequence}+No Sequence": {
        "kind": "static",
        "label": "Shots with no Sequence",
        "icon": "asset",
        "child_filters": {
            "shot": {
                "search_filter": "components[medm21619349.shared:type.deliverable.shot-1.0.0].sequence.objectId.id=notstartswith='urn:medm:'"
            }
        }
    },
    "{Shot}": {
        "kind": "token",
        "label": "{DATA.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.shot-1.0.0'"
        },
        "child_filters": {
            "step": {
                "assets_resolver": "COMPONENT(name=Pipeline Steps).PROPERTY($id:targetStep)"
            }
        }
    }
}
