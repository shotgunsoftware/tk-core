{
    "assets" : {
        "kind": "static",
        "label": "Assets",
        "icon": "folder",
        "forward_filters": {
            "deliverable": {
                "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.asset-1.0.0'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Asset'"
            }
        }
    },
    "shots" : {
        "kind": "static",
        "label": "Shots",
        "icon": "folder",
        "forward_filters": {
            "deliverable": {
                "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.shot-1.0.0'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Shot'"
            }
        }
    },
    "sequences" : {
        "kind": "static",
        "label": "Sequences",
        "icon": "folder",
        "forward_filters": {
            "deliverable": {
                "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.sequence-1.0.0'"
            }
        }
    },
    "{sg_asset_type}": {
        "kind": "token",
        "label": "{ITEM.PROPERTY(name)}",
        "icon": "folder",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.dynamicEnum-1.0.0';components[medm21619349.shared:type.dynamicEnum-1.0.0].propertyScope=='Asset Type'",
            "items": "COMPONENT(name=Dynamic Enum).PROPERTY($id:values)",
            "item": "COMPONENT(name=Dynamic Enum Value)"
        },
        "forward_filters": {
            "asset": {
                "search_filter": "components[medm21619349.shared:type.deliverable.asset-1.0.0].assetType=='{ITEM.COMPONENT(name=Dynamic Enum Value).PROPERTY(name)}'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Asset'"
            }
        }
    },
    "{sg_shot_type}": {
        "kind": "token",
        "label": "{ITEM.PROPERTY(name)}",
        "icon": "folder",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.dynamicEnum-1.0.0';components[medm21619349.shared:type.dynamicEnum-1.0.0].propertyScope=='Shot Type'",
            "items": "COMPONENT(name=Dynamic Enum).PROPERTY($id:values)",
            "item": "COMPONENT(name=Dynamic Enum Value)"
        },
        "forward_filters": {
            "shot": {
                "search_filter": "components[medm21619349.shared:type.deliverable.shot-1.0.0].shotType=='{ITEM.COMPONENT(name=Dynamic Enum Value).PROPERTY(name)}'"
            },
            "step": {
                "search_filter": "components[medm21619349.shared:type.pipelineStep-1.0.3].entityType=='Shot'"
            }
        }
    },
    "{Asset}": {
        "kind": "token",
        "label": "{ITEM.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.asset-1.0.0'"
        },
        "forward_filters": {
            "step": {
                "asset_filter": "COMPONENT(name=Pipeline Steps).PROPERTY($id:targetStep)"
            }
        }
    },
    "{Step}": {
        "kind": "token",
        "label": "{ITEM.PROPERTY(name)}",
        "icon": "color:{ITEM.PROPERTY(backgroundColor)}",
        "color": "{ITEM.PROPERTY(backgroundColor)}",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.pipelineStep-1.0.3'",
            "item": "COMPONENT(name=Pipeline Step)"
        }
    },
    "{Episode}": {
        "kind": "token",
        "label": "{ITEM.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.episode-1.0.0'"
        },
        "forward_filters": {
            "sequence": {
                "search_filter": "components[medm21619349.shared:type.deliverable.sequence-1.0.0].episode.objectId.id=={ITEM.ATTRIBUTE(id)}"
            }
        }
    },
    "{Sequence}": {
        "kind": "token",
        "label": "{ITEM.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.sequence-1.0.0'"
        },
        "forward_filters": {
            "shot": {
                "search_filter": "components[medm21619349.shared:type.deliverable.shot-1.0.0].sequence.objectId.id=={ITEM.ATTRIBUTE(id)}"
            }
        }
    },
    "{Shot}": {
        "kind": "token",
        "label": "{ITEM.ATTRIBUTE(name)}",
        "icon": "asset",
        "resolution": {
            "search_filter": "components.typeId=='medm21619349.shared:type.deliverable.shot-1.0.0'"
        },
        "forward_filters": {
            "step": {
                "asset_filter": "COMPONENT(name=Pipeline Steps).PROPERTY($id:targetStep)"
            }
        }
    }
